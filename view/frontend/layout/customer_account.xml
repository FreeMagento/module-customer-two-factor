<?xml version="1.0"?>
<!-- Adds "Login Security" to the My Account sidebar -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="customer-account-navigation-twofactor-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Login Security</argument>
                    <argument name="path" xsi:type="string">twofactor/account</argument>
                    <argument name="sortOrder" xsi:type="number">235</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
