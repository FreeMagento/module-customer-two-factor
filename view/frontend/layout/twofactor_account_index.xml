<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title>Login Security</title>
    </head>
    <body>
        <referenceContainer name="content">
            <block name="freemagento.twofactor.account"
                   template="FreeMagento_CustomerTwoFactor::account/settings.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">FreeMagento\CustomerTwoFactor\ViewModel\Account</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
