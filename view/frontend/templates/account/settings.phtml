<?php
/**
 * My Account > Login Security.
 *
 * Block arguments a theme can set in layout: card_css_classes (default "card"), heading_css_classes (default "text-xl font-medium"), muted_css_classes (default "text-secondary").
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
declare(strict_types=1);

use FreeMagento\CustomerTwoFactor\ViewModel\Account;

/** @var Account $vm */
$vm = $block->getData('view_model');
$cardClasses = (string)($block->getData('card_css_classes') ?: 'card');
$headingClasses = (string)($block->getData('heading_css_classes') ?: 'text-xl font-medium');
$muted = $escaper->escapeHtmlAttr((string)($block->getData('muted_css_classes') ?: 'text-secondary'));
$devices = $vm->isTrustedDeviceEnabled() ? $vm->getTrustedDevices() : [];
?>
<div class="mw-twofactor-account flex flex-col gap-6">

    <?php if (!$vm->isFeatureEnabled()): ?>
        <div class="<?= $escaper->escapeHtmlAttr($cardClasses) ?>">
            <h2 class="<?= $escaper->escapeHtmlAttr($headingClasses) ?>"><?= $escaper->escapeHtml(__('Two-factor authentication')) ?></h2>
            <p class="mt-2 <?= $muted ?>"><?= $escaper->escapeHtml(__('Two-factor authentication is not available on this store at the moment.')) ?></p>
        </div>
    <?php else: ?>

        <div class="<?= $escaper->escapeHtmlAttr($cardClasses) ?>">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="max-w-xl">
                    <h2 class="<?= $escaper->escapeHtmlAttr($headingClasses) ?>"><?= $escaper->escapeHtml(__('Two-factor authentication')) ?></h2>
                    <p class="mt-2 <?= $muted ?>">
                        <?= $escaper->escapeHtml(__("When it's on, we email a one-time code to %1 after you enter your password. Your account stays protected even if someone learns your password.", $vm->getCustomer()->getEmail())) ?>
                    </p>
                </div>
                <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm <?= $vm->isActive() ? 'border-green-600 text-green-700' : 'border-gray-300 ' . $muted ?>">
                    <span class="h-2 w-2 rounded-full <?= $vm->isActive() ? 'bg-green-600' : 'bg-gray-400' ?>" aria-hidden="true"></span>
                    <?= $escaper->escapeHtml($vm->isActive() ? __('On') : __('Off')) ?>
                </span>
            </div>

            <?php if ($vm->isRequiredByStore()): ?>
                <p class="mt-4 text-sm <?= $muted ?>">
                    <?= $escaper->escapeHtml(__('Two-factor authentication is required for every account on this store and cannot be switched off.')) ?>
                </p>
            <?php else: ?>
                <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('twofactor/account/save')) ?>" class="mt-6">
                    <?= $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="enabled" value="<?= $vm->isActive() ? '0' : '1' ?>">
                    <?php if ($vm->isActive()): ?>
                        <button type="submit" class="btn btn-secondary"><?= $escaper->escapeHtml(__('Turn off two-factor authentication')) ?></button>
                    <?php else: ?>
                        <button type="submit" class="btn btn-primary"><?= $escaper->escapeHtml(__('Turn on two-factor authentication')) ?></button>
                    <?php endif; ?>
                </form>
            <?php endif; ?>
        </div>

        <?php if ($vm->isTrustedDeviceEnabled() && $vm->isActive()): ?>
            <div class="<?= $escaper->escapeHtmlAttr($cardClasses) ?>">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div class="max-w-xl">
                        <h2 class="<?= $escaper->escapeHtmlAttr($headingClasses) ?>"><?= $escaper->escapeHtml(__('Remembered devices')) ?></h2>
                        <p class="mt-2 <?= $muted ?>">
                            <?= $escaper->escapeHtml(__("Browsers you've ticked \"Remember this device\" on skip the code for %1 days. Forget any you don't recognise.", $vm->getTrustedDeviceLifetime())) ?>
                        </p>
                    </div>
                    <?php if (count($devices) > 1): ?>
                        <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('twofactor/account/revoke')) ?>">
                            <?= $block->getBlockHtml('formkey') ?>
                            <input type="hidden" name="all" value="1">
                            <button type="submit" class="btn btn-secondary"><?= $escaper->escapeHtml(__('Forget all devices')) ?></button>
                        </form>
                    <?php endif; ?>
                </div>

                <?php if (!$devices): ?>
                    <p class="mt-4 text-sm <?= $muted ?>"><?= $escaper->escapeHtml(__('No devices are remembered right now.')) ?></p>
                <?php else: ?>
                    <ul class="mt-6 divide-y divide-gray-200">
                        <?php foreach ($devices as $device): ?>
                            <li class="flex flex-wrap items-center justify-between gap-4 py-4">
                                <div>
                                    <p class="font-medium">
                                        <?= $escaper->escapeHtml($device['label']) ?>
                                        <?php if ($device['current']): ?>
                                            <span class="ml-2 rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800"><?= $escaper->escapeHtml(__('This device')) ?></span>
                                        <?php endif; ?>
                                    </p>
                                    <p class="mt-1 text-sm <?= $muted ?>">
                                        <?= $escaper->escapeHtml(__('Last used %1', $device['last_used'])) ?>
                                        <?php if ($device['ip']): ?> &middot; <?= $escaper->escapeHtml($device['ip']) ?><?php endif; ?>
                                        &middot; <?= $escaper->escapeHtml(__('Expires %1', $device['expires'])) ?>
                                    </p>
                                </div>
                                <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('twofactor/account/revoke')) ?>">
                                    <?= $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="id" value="<?= (int)$device['id'] ?>">
                                    <button type="submit" class="text-sm underline hover:no-underline"><?= $escaper->escapeHtml(__('Forget')) ?></button>
                                </form>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>
            </div>
        <?php endif; ?>

    <?php endif; ?>
</div>
