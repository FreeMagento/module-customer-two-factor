<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="freemagento_twofactor_code" resource="default" engine="innodb" comment="Customer 2FA one-time codes (one active per customer)">
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="code_hash" nullable="false" length="128" comment="HMAC of the code"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Wrong attempts so far"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent at"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Valid until"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MW_TWOFACTOR_CODE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="freemagento_twofactor_code" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MW_TWOFACTOR_CODE_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>

    <table name="freemagento_twofactor_trusted_device" resource="default" engine="innodb" comment="Customer 2FA trusted devices">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Device ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="token_hash" nullable="false" length="128" comment="HMAC of the cookie token"/>
        <column xsi:type="varchar" name="user_agent" nullable="true" length="255" comment="Browser user agent (truncated)"/>
        <column xsi:type="varchar" name="ip_address" nullable="true" length="45" comment="IP at time of trust"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Trusted at"/>
        <column xsi:type="timestamp" name="last_used_at" nullable="true" comment="Last sign-in with this device"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Trust expires"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MW_TWOFACTOR_TRUSTED_DEVICE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="freemagento_twofactor_trusted_device" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MW_TWOFACTOR_TRUSTED_DEVICE_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="MW_TWOFACTOR_TRUSTED_DEVICE_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>
</schema>
