<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="freemagento_twofactor" translate="label" type="text" sortOrder="310" showInDefault="1" showInWebsite="1" showInStore="0">
            <class>separator-top</class>
            <label>Two-Factor Authentication</label>
            <tab>customer</tab>
            <resource>FreeMagento_CustomerTwoFactor::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Storefront Login</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enable Two-Factor Authentication</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>After a correct password the customer is emailed a one-time code and must enter it before they are signed in.</comment>
                </field>
                <field id="mode" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enforcement</label>
                    <source_model>FreeMagento\CustomerTwoFactor\Model\Config\Source\Mode</source_model>
                    <comment>Optional: customers switch it on under My Account &#8250; Login Security. Required: every customer must verify a code on sign-in.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="code" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>One-Time Code</label>
                <field id="lifetime" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Code Lifetime (minutes)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <comment>How long a code stays valid after it is sent.</comment>
                </field>
                <field id="max_attempts" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Maximum Wrong Attempts</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <comment>After this many wrong entries the code is discarded and a new one must be requested.</comment>
                </field>
                <field id="resend_cooldown" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Resend Cooldown (seconds)</label>
                    <validate>required-entry validate-digits</validate>
                    <comment>Minimum wait before another code can be requested.</comment>
                </field>
                <field id="email_template" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
                <field id="email_identity" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Email Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
            </group>

            <group id="trusted_device" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Trusted Devices</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Allow "Remember this device"</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lets the customer skip the code on a browser they have already verified. Customers can revoke devices under Login Security.</comment>
                </field>
                <field id="lifetime" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Remember For (days)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="checked_by_default" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Tick "Remember this device" by Default</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
